TEAM_ID=S5NQXKYPKT

// PRODUCT_NAME must stay plain ASCII. A non-ASCII character (such as the umlaut
// in the German name) in the executable name causes an NFC/NFD Unicode
// normalization mismatch between the binary's filename and CFBundleExecutable,
// so codesign seals the main binary as a resource and the signature
// self-invalidates -> App Store rejection ITMS-90034. The user-facing name (with
// the umlaut) lives in CFBundleDisplayName in iosApp/Info.plist.
PRODUCT_NAME=MensaApp
PRODUCT_BUNDLE_IDENTIFIER=com.lkaesberg.mensaapp.ComposeApp

// Version numbers — both are set automatically on Xcode Cloud by
// ci_scripts/ci_pre_xcodebuild.sh, so uploads can never be rejected for a
// duplicate or closed version. You never have to bump anything by hand to ship.
//
// Release (tag) builds: pushing a git tag like v1.1 stamps MARKETING_VERSION
// with the tag itself (v1.1 -> public App Store version 1.1), and
// .github/workflows/release-app-store.yml then writes the release notes and
// submits that build for review automatically. See .github/RELEASING.md.
//
// Branch (main) builds: CI stamps <major.minor>.<CI_BUILD_NUMBER> (e.g. 1.1.37)
// for TestFlight, where major.minor comes from the latest release tag. The
// MARKETING_VERSION below is only the FALLBACK base when no tag is visible to
// the build — keep it roughly in sync with the latest release tag; only ever
// raise it, never lower it.
//
// CURRENT_PROJECT_VERSION (CFBundleVersion, the build number) is always set to
// CI_BUILD_NUMBER by CI. The values below are used only for local/dev builds.
CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0
