TEAM_ID=S5NQXKYPKT

// PRODUCT_NAME must stay plain ASCII. A non-ASCII character (such as the umlaut
// in the German name) in the executable name causes an NFC/NFD Unicode
// normalization mismatch between the binary's filename and CFBundleExecutable,
// so codesign seals the main binary as a resource and the signature
// self-invalidates -> App Store rejection ITMS-90034. The user-facing name (with
// the umlaut) lives in CFBundleDisplayName in iosApp/Info.plist.
PRODUCT_NAME=MensaApp
PRODUCT_BUNDLE_IDENTIFIER=com.lkaesberg.mensaapp.ComposeApp

// Version numbers — both are set automatically on Xcode Cloud, so uploads can
// never be rejected for a duplicate or closed version. You never have to bump
// anything by hand to ship.
//
// MARKETING_VERSION below is the human-controlled MAJOR.MINOR base — the part you
// actually name (1.0, 1.1, 2.0 ...). ci_scripts/ci_pre_xcodebuild.sh appends the
// build number as the patch, so the PUBLIC App Store version becomes e.g. 1.0.12,
// always unique and always higher than anything already approved. Bump the
// major.minor here to mark a milestone (set 1.1 -> ships as 1.1.<build>); only
// ever raise it, never lower it.
//
// CURRENT_PROJECT_VERSION (CFBundleVersion, the build number) is likewise set to
// CI_BUILD_NUMBER by CI. The values below are used only for local/dev builds.
CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0
